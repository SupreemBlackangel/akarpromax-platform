# =============================================================================
# AkarProMax — environment template (Phase 5)
# All values are safe placeholders. Never commit real secrets.
# Full reference: docs/runtime/ENVIRONMENT_MATRIX.md
# =============================================================================

# Runtime profile: development | test | production. MUST be "production" in prod.
NODE_ENV=development

# MySQL connection for the production content backend
# (drizzle.mysql.config.ts + lib/mysql-runtime.ts + lib/mysql-db.ts).
# REQUIRED when DB_PROVIDER=mysql.
DATABASE_URL=

# Explicit database provider. Values: mysql | d1 | postgres (deprecated).
# Production defaults to mysql; d1 is also accepted (Cloudflare Workers).
# Postgres is rejected in production (WEB-03).
DB_PROVIDER=mysql

# MySQL connection for the production content and auth backend
# (drizzle.mysql.config.ts + lib/mysql-runtime.ts + lib/mysql-db.ts).
# REQUIRED when DB_PROVIDER=mysql.
MYSQL_URL=mysql://root:root@localhost:3306/akarpromax?charset=utf8mb4

# JWT session signing secret (32+ random bytes). REQUIRED in production.
# Weak/placeholder values are REJECTED at boot (fail-fast).
SESSION_SECRET=REPLACE_WITH_32_BYTE_RANDOM_STRING

# Canonical public origin for absolute URLs and Origin-header validation (CSRF).
# No trailing slash. REQUIRED in production. Example: https://akarpromax.com
# APP_PUBLIC_URL, when set, takes precedence over APP_URL for link generation
# (email verification links, reset links) — set it to the externally reachable
# origin so staging/production never generates localhost links.
APP_PUBLIC_URL=
APP_URL=

# Comma-separated additional trusted origins. REQUIRED in production
# (>=1 entry). localhost is trusted only in development.
TRUSTED_ORIGINS=

# Demo/seed data opt-in (news, plans, integration demo, services marketplace).
# DEVELOPMENT_ONLY: ignored and force-blocked in production.
SEED_DEMO_DATA=false

# Email delivery. EMAIL_TRANSPORT selects the transport explicitly:
#   console -> sink transport (development/test only, NEVER production-capable)
#   smtp    -> real SMTP delivery via nodemailer
# Unset (legacy): auto-detected from SMTP_HOST.
# Under NODE_ENV=production, /api/health/ready returns 503 (not_ready) unless
# the SMTP transport is fully configured and productionCapable=true.
# NOTE: the codebase reads SMTP_PASS (not SMTP_PASSWORD). Provider docs may call
# it SMTP_PASSWORD — map it to SMTP_PASS in your secret store.
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@akarpromax.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AkarProMax
MAIL_REPLY_TO=

# DNS/DELIVERABILITY (must be configured on the sending domain for real inbox
# delivery): SPF, DKIM, and DMARC records. SMTP auth alone is NOT deliverability.
# Domain verification requires Product Owner approval and domain/DNS changes.


# HMAC secret for ad-tracking click/impression tokens. Set a strong value in
# production; a public default is used when unset.
AD_TRACKING_SECRET=

# Development convenience login. Accepts "true" ONLY when NODE_ENV=development;
# force-blocked in production and tests even if set.
ENABLE_DEV_LOGIN=false

# Migration-only admin bootstrap (scripts/seed-auth-admin.ts). Never read by the
# app at runtime. Override in any non-local run.
# If SEED_ADMIN_PASSWORD is empty/unset a strong one-time password is generated
# and printed once at seed time (never stored) — set it explicitly in shared/staging/prod.
SEED_ADMIN_EMAIL=admin@localhost.akarpromax
SEED_ADMIN_PASSWORD=

# =============================================================================
# STAGING / PRODUCTION MINIMUM SET (see docs/release/STAGING_ENVIRONMENT_MATRIX.md)
# All values here are safe placeholders — never commit real secrets.
# =============================================================================
# NODE_ENV=production          # MUST be exported: vinext start does not set it
# DB_PROVIDER=mysql            # production default; d1 also accepted (Cloudflare Workers)
# DATABASE_URL=<staging pg>    # isolated staging DB, never production
# SESSION_SECRET=<64-hex>      # >=32 chars, non-weak, not a dev/test fallback
# APP_PUBLIC_URL=https://staging.akarpromax.com   # no localhost/127.0.0.1
# TRUSTED_ORIGINS=https://staging.akarpromax.com
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=<provider relay>; SMTP_PORT=587; SMTP_SECURE=false
# SMTP_USER=no-reply@staging.akarpromax.com
# SMTP_PASS=<provider secret>
# MAIL_FROM_ADDRESS=no-reply@staging.akarpromax.com
# MAIL_REPLY_TO=support@staging.akarpromax.com
# AD_TRACKING_SECRET=<64-hex>  # required: unset falls back to a PUBLIC constant
# R2 binding SPONSOR_ASSETS must exist for sponsor/ad uploads (deployment config,
# not an env var).
# NEVER set ENABLE_DEV_LOGIN=true or EMAIL_TRANSPORT=console on staging.

# ─── OAuth / Social Login ──────────────────────────────────────────────────
# Google OAuth 2.0 — create credentials at https://console.cloud.google.com/
# Authorized redirect URI: ${APP_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login — create app at https://developers.facebook.com/
# Valid OAuth Redirect URI: ${APP_PUBLIC_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
