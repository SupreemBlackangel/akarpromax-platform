# PostgreSQL connection for the auth layer (drizzle-kit + lib/db)
DATABASE_URL=

# MySQL connection for the runtime data fallback (drizzle.mysql.config.ts +
# lib/mysql-runtime.ts + lib/mysql-db.ts). Under `vinext start` the D1 binding
# is unavailable, so data routes (news/sponsors/ads) fall back to MySQL.
MYSQL_URL=mysql://root:root@localhost:3306/akarpromax?charset=utf8mb4

# JWT session signing secret (32+ random bytes). MUST be set in production.
SESSION_SECRET=REPLACE_WITH_32_BYTE_RANDOM_STRING
