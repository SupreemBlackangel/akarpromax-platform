# PostgreSQL connection for the auth layer (drizzle-kit + lib/db)
DATABASE_URL=

# MySQL connection for the runtime data fallback (drizzle.mysql.config.ts +
# lib/mysql-runtime.ts + lib/mysql-db.ts). Under `vinext start` the D1 binding
# is unavailable, so data routes (news/sponsors/ads) fall back to MySQL.
MYSQL_URL=mysql://root:root@localhost:3306/akarpromax?charset=utf8mb4

# JWT session signing secret (32+ random bytes). MUST be set in production.
# The placeholder value below and weak strings ("secret", "changeme", ...) are
# REJECTED at boot in production by lib/config/runtime-env.ts (fail-fast).
SESSION_SECRET=REPLACE_WITH_32_BYTE_RANDOM_STRING

# Canonical public origin, used to build absolute URLs and to validate the
# Origin header on state-changing API requests (CSRF defense). No trailing slash.
# Example: https://akarpromax.om
APP_URL=

# Comma-separated list of additional trusted origins for API requests
# (e.g. https://admin.akarpromax.om). Empty by default; localhost is always
# trusted in development only.
TRUSTED_ORIGINS=

# Development convenience login for local testing. Accepts "true" ONLY when
# NODE_ENV=development; it is force-blocked in production and in tests even if
# this flag is set. Do not enable in production.
ENABLE_DEV_LOGIN=false

# When set to "true", data routes may fall back to MySQL if the D1 schema
# initialisation fails. Production defaults to fail-fast instead.
ALLOW_MYSQL_FALLBACK=false
