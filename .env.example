# =============================================================================
# AkarProMax — environment template (Phase 5)
# All values are safe placeholders. Never commit real secrets.
# Full reference: docs/runtime/ENVIRONMENT_MATRIX.md
# =============================================================================

# Runtime profile: development | test | production. MUST be "production" in prod.
NODE_ENV=development

# PostgreSQL connection for the auth layer and production primary database
# (lib/db + drizzle). REQUIRED in production.
DATABASE_URL=

# Explicit database provider. Values: postgres | mysql | d1.
# Production must equal the declared architecture (postgres per ADR-001).
# REQUIRED in production; unknown values fail fast.
DB_PROVIDER=postgres

# MySQL connection for the LEGACY/optional content backend
# (drizzle.mysql.config.ts + lib/mysql-runtime.ts + lib/mysql-db.ts).
# Only used when DB_PROVIDER=mysql. Optional otherwise.
MYSQL_URL=mysql://root:root@localhost:3306/akarpromax?charset=utf8mb4

# JWT session signing secret (32+ random bytes). REQUIRED in production.
# Weak/placeholder values are REJECTED at boot (fail-fast).
SESSION_SECRET=REPLACE_WITH_32_BYTE_RANDOM_STRING

# Canonical public origin for absolute URLs and Origin-header validation (CSRF).
# No trailing slash. REQUIRED in production. Example: https://akarpromax.om
APP_URL=

# Comma-separated additional trusted origins. REQUIRED in production
# (>=1 entry). localhost is trusted only in development.
TRUSTED_ORIGINS=

# Demo/seed data opt-in (news, plans, integration demo, services marketplace).
# DEVELOPMENT_ONLY: ignored and force-blocked in production.
SEED_DEMO_DATA=false

# SMTP delivery. Optional: when SMTP_HOST is unset, email falls back to the
# console transport and health reports DEGRADED. Never claim verification
# delivery success when no provider is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@akarpromax.om

# HMAC secret for ad-tracking click/impression tokens. Set a strong value in
# production; a public default is used when unset.
AD_TRACKING_SECRET=

# Development convenience login. Accepts "true" ONLY when NODE_ENV=development;
# force-blocked in production and tests even if set.
ENABLE_DEV_LOGIN=false

# Migration-only admin bootstrap (scripts/seed-auth-admin.ts). Never read by the
# app at runtime. Override in any non-local run.
SEED_ADMIN_EMAIL=admin@akarpromax.om
SEED_ADMIN_PASSWORD=ChangeMe123!
